    add option WR_FILTER0
     filter write leveling invalid clk-low-level
    
    Change-Id: Iab9cd75eb3d266f60ac31308a987f2ef301d23e7

diff --git a/Targets/LS2K/conf/ls2k b/Targets/LS2K/conf/ls2k
index f0befa5..fcc3bbc 100644
--- a/Targets/LS2K/conf/ls2k
+++ b/Targets/LS2K/conf/ls2k
@@ -289,3 +289,4 @@ option HPET_RTC
 #option INIT_TIME
 #option SATA_RESET
 #option NO_SMP
+#option	WR_FILTER0
diff --git a/Targets/LS2K/ls2k/ddr_dir/loongson3C_ddr3_leveling.S b/Targets/LS2K/ls2k/ddr_dir/loongson3C_ddr3_leveling.S
index 6dd97a3..abbaf0f 100644
--- a/Targets/LS2K/ls2k/ddr_dir/loongson3C_ddr3_leveling.S
+++ b/Targets/LS2K/ls2k/ddr_dir/loongson3C_ddr3_leveling.S
@@ -221,6 +221,7 @@ lvl_ready_sampling:
 
 /* 5. Set leveling req */
 
+#ifndef  WR_FILTER0
 	GET_NUMBER_OF_SLICES
 	dli	t1, 0x20
 	or	t1, t1, t8
@@ -314,6 +315,134 @@ resp_set0_done:
 	dli     t6, 0x0
 	bnez	t0, lvl_req_set0
 	nop
+#else
+	GET_NUMBER_OF_SLICES
+	dli	t1, 0x20
+	or	t1, t1, t8
+	dli	t2, 0x180
+	or	t2, t2, t8
+	dli	s7, WR_FILTER_LENGTH
+	dli     t6, 0x0
+lvl_req_set0:
+	dli	a0, 0x1
+	sb	a0, 0x181(t8)
+	dli	a0, 0x0
+	sb	a0, 0x181(t8)
+
+#ifdef LVL_DEBUG
+	PRINTSTR("\r\nwrite leveling req set0\r\n")
+#endif
+
+lvl_done_sampling0:
+	lb	a0, 0x186(t8)
+	beqz	a0, lvl_done_sampling0
+	nop
+
+lvl_resp_set0:
+	lb	a0, 0x7(t2)
+	dli	t4, 0xff
+	and 	a0, a0, t4
+	beqz	a0, resp_set0_done
+	nop
+
+	dli	s7, WR_FILTER_LENGTH
+dll_wrdqs_add0:
+	lb	a0, OFFSET_DLL_WRDQS(t1)
+	daddu	a0, a0, 0x1
+	dli	t4, 0x7f
+	and	a0, a0, t4
+	sb	a0, OFFSET_DLL_WRDQS(t1)
+
+#ifdef CHANGE_DQ_WITH_DQS
+	lb	a0, OFFSET_DLL_WRDQS(t1) // get dll_wrdqs
+	blt	a0, WRDQS_LTHF_STD, 1f
+	nop
+	li	t4, 0x0
+	sb	t4, OFFSET_WRDQS_LTHF(t1) //set wrdqs_lt_half
+	b	2f
+	nop
+1:
+	li	t4, 0x1
+	sb	t4, OFFSET_WRDQS_LTHF(t1) //set wrdqs_lt_half
+2:
+	dsubu	a0, a0, 0x20
+	dli	t4, 0x7f
+	and	a0, a0, t4
+	sb	a0, OFFSET_DLL_WRDQ(t1) // set dll_wrdata
+
+	blt	a0, WRDQ_LTHF_STD, 1f
+	nop
+	li	t4, 0x0
+	sb	t4, OFFSET_WRDQ_LTHF(t1) //set wrdq_lt_half
+	b	2f
+	nop
+1:
+	li	t4, 0x1
+	sb	t4, OFFSET_WRDQ_LTHF(t1) //set wrdq_lt_half
+2:
+#endif
+	bgt     t6, MDL_CNT, leveling_failed
+	nop
+	daddu   t6, t6, 0x1
+	b 	lvl_req_set0
+	nop
+
+resp_set0_done:
+#ifdef	LVL_DEBUG
+	PRINTSTR("\r\n 0 is found @ slice")
+	dli	a0, 0x8
+	dsubu	a0, a0, t0
+	bal 	hexserial
+	nop
+#endif
+	dsubu	s7, s7, 0x1
+	bnez	s7, dll_wrdqs_add0
+	nop
+	dli	s7, WR_FILTER_LENGTH
+
+//  return the more add
+	lb	a0, OFFSET_DLL_WRDQS(t1)
+	dsubu	a0, a0, WR_FILTER_LENGTH
+	daddu	a0, a0, 0x1
+	dli	t4, 0x7f
+	and	a0, a0, t4
+	sb	a0, OFFSET_DLL_WRDQS(t1)
+
+#ifdef CHANGE_DQ_WITH_DQS
+	lb	a0, OFFSET_DLL_WRDQS(t1) // get dll_wrdqs
+	blt	a0, WRDQS_LTHF_STD, 1f
+	nop
+	li	t4, 0x0
+	sb	t4, OFFSET_WRDQS_LTHF(t1) //set wrdqs_lt_half
+	b	2f
+	nop
+1:
+	li	t4, 0x1
+	sb	t4, OFFSET_WRDQS_LTHF(t1) //set wrdqs_lt_half
+2:
+	dsubu	a0, a0, 0x20
+	dli	t4, 0x7f
+	and	a0, a0, t4
+	sb	a0, OFFSET_DLL_WRDQ(t1) // set dll_wrdata
+
+	blt	a0, WRDQ_LTHF_STD, 1f
+	nop
+	li	t4, 0x0
+	sb	t4, OFFSET_WRDQ_LTHF(t1) //set wrdq_lt_half
+	b	2f
+	nop
+1:
+	li	t4, 0x1
+	sb	t4, OFFSET_WRDQ_LTHF(t1) //set wrdq_lt_half
+2:
+#endif
+	dsubu	t0, t0, 0x1
+	daddu	t1, t1, 0x20
+	daddu	t2, t2, 0x1
+	dli	    t6, 0x0
+	bnez	t0, lvl_req_set0
+	nop
+#endif
 
 /* 0 to 1 */
 	GET_NUMBER_OF_SLICES
